{
  "name": "youputdesk",
  "productName": "YouputDesk",
  "version": "0.1.2",
  "description": "YouTube Music desktop client for Windows",
  "type": "module",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "npm run typecheck && npm test && electron-vite build && electron-builder --win",
    "release": "npm run typecheck && npm test && electron-vite build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "preact": "^10.29.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.5.1": true,
    "electron-winstaller": false
  },
  "author": "roderio",
  "build": {
    "appId": "com.youputdesk.app",
    "productName": "YouputDesk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouputDesk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "publish": {
      "provider": "github",
      "owner": "roderio",
      "repo": "youputdesk",
      "releaseType": "draft"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/roderio/youputdesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/roderio/youputdesk.git"
  },
  "license": "MIT"
}
